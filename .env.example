# Copy to .env. Paths must be outside this source directory.
VOICE_DATA_DIR=~/.local/share/voice-practice
WHISPER_MODEL_DIR=~/.local/share/voice-practice/models/small.en
# Required: the exact installed LOCAL Gemma model tag. No default or fallback.
GEMMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
MAX_UPLOAD_MB=30
MAX_DURATION_SECONDS=180
WHISPER_CPU_THREADS=8
# Explicit UI development mode. Mock sessions are permanently labeled.
MOCK_MODE=false
